# ===========================================================================
# Bá Khí — .env.example  (8.5.2)
#
# ĐÂY LÀ TỆP MẪU. Không có giá trị thật trong tệp này.
# Không commit tệp .env chứa khoá thật (đã nằm trong .gitignore).
#
# Với AI Tutor, khoá KHÔNG đặt ở frontend và KHÔNG đặt trong tệp này khi chạy
# thật: khoá được lưu trong **Supabase → Edge Functions → Secrets**.
# Hướng dẫn từng bước: docs/AI_TUTOR_API_KEY_SETUP.md
# ===========================================================================

# --- Supabase (bắt buộc, chỉ dùng khoá công khai ở frontend) ----------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CHỈ dùng trong Edge Function Secrets, KHÔNG đưa vào frontend:
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Trợ lý AI: nhà cung cấp chính (mặc định: Groq) ------------------------
# groq | google | openai | cerebras | openrouter | mistral | deepseek | custom
# Ghi chú: PROVIDER/MODEL dưới đây chỉ là giá trị khởi tạo cho môi trường mới.
# Khi chạy thật, provider/model đọc từ bảng `ai_settings` (Founder Dashboard).
AI_TUTOR_PROVIDER=groq
AI_TUTOR_MODEL=openai/gpt-oss-20b
AI_TUTOR_API_KEY=<dán-khoá-vào-supabase-secrets-không-dán-vào-đây>
# Chỉ cần khi AI_TUTOR_PROVIDER=custom (API tương thích OpenAI):
# AI_TUTOR_BASE_URL=https://<host>/v1

# --- Trợ lý AI: nhà cung cấp dự phòng (tuỳ chọn) ----------------------------
# Chỉ chạy khi có AI_TUTOR_FALLBACK_API_KEY. Đổi sang false để tắt hoàn toàn.
AI_TUTOR_FALLBACK_ENABLED=true
AI_TUTOR_FALLBACK_PROVIDER=google
AI_TUTOR_FALLBACK_MODEL=gemini-3.8-flash
AI_TUTOR_FALLBACK_API_KEY=<dán-khoá-dự-phòng-vào-supabase-secrets>
# AI_TUTOR_FALLBACK_BASE_URL=

# --- Trợ lý AI: thử lại & thời gian chờ ------------------------------------
# Số lần thử lại provider chính khi lỗi tạm thời (429/5xx/timeout). 0–2.
AI_TUTOR_MAX_RETRIES=1
# Thời gian chờ mỗi lượt gọi (ms). Để trống để dùng cấu hình trong database.
AI_TUTOR_TIMEOUT=30000

# --- Chỉ dùng cho kiểm thử offline -----------------------------------------
# Hướng dẫn cấu hình từng bước (cho người không lập trình):
# docs/AI_TUTOR_PROVIDER_CONFIGURATION.md
# '1' = bật provider giả lập. KHÔNG bật ở production.
AI_TUTOR_MOCK=0
