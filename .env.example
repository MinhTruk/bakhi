# ===========================================================================
# Bá Khí — .env.example  (8.5.0)
#
# ĐÂY LÀ TỆP MẪU. Không có giá trị thật trong tệp này.
# Không commit tệp .env chứa khoá thật (đã nằm trong .gitignore).
#
# Với AI Tutor, khoá KHÔNG đặt ở frontend và KHÔNG đặt trong tệp này khi chạy
# thật: khoá được lưu trong **Supabase → Edge Functions → Secrets**.
# Hướng dẫn từng bước: docs/AI_TUTOR_API_KEY_SETUP.md
# ===========================================================================

# --- Supabase (bắt buộc, chỉ dùng khoá công khai ở frontend) ----------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CHỈ dùng trong Edge Function Secrets, KHÔNG đưa vào frontend:
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Trợ lý AI: nhà cung cấp chính -----------------------------------------
# google | openai | groq | openrouter | mistral | deepseek | custom
AI_TUTOR_PROVIDER=google
AI_TUTOR_MODEL=<model-id>
AI_TUTOR_API_KEY=<dán-khoá-vào-supabase-secrets-không-dán-vào-đây>
# Chỉ cần khi AI_TUTOR_PROVIDER=custom (API tương thích OpenAI):
# AI_TUTOR_BASE_URL=https://<host>/v1

# --- Trợ lý AI: nhà cung cấp dự phòng (tuỳ chọn) ----------------------------
AI_TUTOR_FALLBACK_PROVIDER=
AI_TUTOR_FALLBACK_MODEL=
AI_TUTOR_FALLBACK_API_KEY=<dán-khoá-dự-phòng-vào-supabase-secrets>
# AI_TUTOR_FALLBACK_BASE_URL=

# --- Chỉ dùng cho kiểm thử offline -----------------------------------------
# '1' = bật provider giả lập. KHÔNG bật ở production.
AI_TUTOR_MOCK=0
