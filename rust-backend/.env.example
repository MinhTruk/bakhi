# ===========================================================================
# Bá Khí — Rust backend · .env.example
#
# TỆP MẪU. Không có giá trị thật. Không commit .env chứa khoá thật.
# Đặt biến này trong secret manager của nền tảng deploy (hoặc file .env chỉ
# tồn tại trên máy chủ, đã nằm trong .gitignore).
# ===========================================================================

# --- Máy chủ --------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
RUST_LOG=bakhi_backend=info,tower_http=warn
# Origin được phép gọi API (phân tách bằng dấu phẩy). Không dùng "*".
CORS_ORIGINS=https://minhtruk.github.io

# --- Supabase -------------------------------------------------------------
# URL + publishable key (giống assets/bakhi/bk-supabase.config.js).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CHỈ ở máy chủ: đọc ai_settings / ai_model_routes và ghi ai_usage_logs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- AI Tutor -------------------------------------------------------------
# Cùng tên biến với Supabase Edge Function Secrets để chuyển đổi không phải sửa.
AI_TUTOR_API_KEY=<provider-key>
AI_TUTOR_FALLBACK_API_KEY=<fallback-provider-key>
# Chỉ cần khi provider = custom (API tương thích OpenAI):
# AI_TUTOR_BASE_URL=https://<host>/v1
# Khoá bổ sung cho ai_model_routes.key_ref (tuỳ chọn):
# AI_TUTOR_KEY_3=
# AI_TUTOR_KEY_4=
AI_TUTOR_MAX_RETRIES=1
AI_TUTOR_TIMEOUT=30000
# 1 = provider giả lập. KHÔNG bật ở production.
AI_TUTOR_MOCK=0
# Ghi hội thoại vào Supabase như Edge Function hiện tại (true/false).
AI_PERSIST_CONVERSATIONS=true

# --- Giới hạn & thời gian chờ --------------------------------------------
# Timeout theo lớp. Ràng buộc khi khởi động:
#   CONNECT_TIMEOUT_MS ≤ AI_TUTOR_TIMEOUT ≤ AI_GATEWAY_TIMEOUT_MS ≤ REQUEST_TIMEOUT_MS
# 8.7.1: RUST_CONNECT_TIMEOUT_SECS / RUST_REQUEST_TIMEOUT_SECS (giây) được ưu tiên
# nếu có; đặt cả hai dạng cùng lúc là hợp lệ nhưng dạng giây thắng.
CONNECT_TIMEOUT_MS=5000
AI_GATEWAY_TIMEOUT_MS=40000
SUPABASE_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=45000
# Chờ tối đa request đang chạy khi nhận SIGTERM/SIGINT.
SHUTDOWN_GRACE_MS=20000
# Chờ tối thiểu giữa hai lần thử provider (Retry-After có thể tăng, trần 30 giây).
AI_RETRY_BACKOFF_MS=500
MAX_BODY_BYTES=262144
RATE_LIMIT_PER_MIN=240
AI_RATE_LIMIT_PER_MIN=30

# --- Đồng thời (8.6.1, mở rộng 8.7.1) ------------------------------------
# Request đồng thời toàn dịch vụ / lượt gọi AI / mỗi người dùng / mỗi provider.
# AI_USER_MAX_CONCURRENCY=1 giống khoá inFlight của Edge Function.
# Tên RUST_* (8.7.1) được ưu tiên; tên cũ vẫn đọc được nên cấu hình đang chạy
# không phải sửa. Ví dụ:
#   RUST_MAX_CONCURRENT_REQUESTS=100
#   RUST_MAX_CONCURRENT_AI_REQUESTS=20
#   RUST_MAX_CONCURRENT_PROVIDER_REQUESTS=10
MAX_CONCURRENCY=512
AI_MAX_CONCURRENCY=32
AI_USER_MAX_CONCURRENCY=1
AI_PROVIDER_MAX_CONCURRENCY=10
# Thời gian chờ lấy semaphore; hết hạn trả 429 thay vì treo.
CONCURRENCY_WAIT_MS=750

# --- Runtime / HTTP pool (8.7.1) -----------------------------------------
# Số worker thread Tokio. Để trống/0 = Tokio tự chọn theo số CPU (khuyến nghị).
# Chỉ đặt khi cần giới hạn CPU của container. Trần hợp lệ: 256.
# RUST_WORKER_THREADS=4
# Số kết nối idle giữ lại cho mỗi host (Supabase, từng provider AI).
RUST_POOL_MAX_IDLE_PER_HOST=32
# Giây giữ kết nối idle trước khi đóng (1–86400).
RUST_IDLE_CONNECTION_TIMEOUT_SECS=90

# --- Circuit breaker theo provider (8.6.1) --------------------------------
AI_CIRCUIT_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=30000
AI_CIRCUIT_HALF_OPEN=1

# --- Intelligent Caching (8.7.3) ------------------------------------------
# CACHE_ENABLED=0 là rollback ngay: không cache gì, hành vi như 8.7.2.
CACHE_ENABLED=1
CACHE_L1_ENABLED=1
CACHE_DEDUP_ENABLED=1
CACHE_MAX_ENTRIES=512
CACHE_MAX_MEMORY_BYTES=8388608
CACHE_DEFAULT_TTL=60
# Cấu hình AI (ai_settings, ai_model_routes). 0 = không cache cấu hình.
CACHE_TTL_AI_CONFIG=30
# Chỉ phục vụ bản cũ trong khoảng này khi nguồn dữ liệu lỗi (giây).
CACHE_STALE_WHILE_REVALIDATE=120
CACHE_TTL_JITTER_PERCENT=10
# --- Metrics / Observability (8.6.2) --------------------------------------
# Mặc định TẮT. Phục vụ GET /metrics (và /api/v1/metrics) khi BẬT và có token.
METRICS_ENABLED=0
# METRICS_TOKEN=<token dài, ngẫu nhiên; gửi bằng Authorization: Bearer>

# Bảng giá AI tách khỏi logic (USD / 1.000.000 token). Chọn MỘT trong hai.
# Model không có giá sẽ được đếm vào bakhi_ai_unpriced_requests_total,
# KHÔNG bao giờ bị tính là 0 USD.
# AI_PRICING_JSON={"version":"2026-11-24","currency":"USD","models":[{"provider":"groq","model":"openai/gpt-oss-20b","input_per_million":null,"output_per_million":null}]}
# AI_PRICING_FILE=/etc/bakhi/pricing.json

# Chỉ bật khi chạy sau reverse proxy có kiểm soát (tin X-Forwarded-For).
TRUST_PROXY=false
