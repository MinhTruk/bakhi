# ===========================================================================
# Bá Khí — Rust backend · .env.example
#
# TỆP MẪU. Không có giá trị thật. Không commit .env chứa khoá thật.
# Đặt biến này trong secret manager của nền tảng deploy (hoặc file .env chỉ
# tồn tại trên máy chủ, đã nằm trong .gitignore).
# ===========================================================================

# --- Máy chủ --------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
RUST_LOG=bakhi_backend=info,tower_http=warn
# Origin được phép gọi API (phân tách bằng dấu phẩy). Không dùng "*".
CORS_ORIGINS=https://minhtruk.github.io

# --- Supabase -------------------------------------------------------------
# URL + publishable key (giống assets/bakhi/bk-supabase.config.js).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CHỈ ở máy chủ: đọc ai_settings / ai_model_routes và ghi ai_usage_logs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- AI Tutor -------------------------------------------------------------
# Cùng tên biến với Supabase Edge Function Secrets để chuyển đổi không phải sửa.
AI_TUTOR_API_KEY=<provider-key>
AI_TUTOR_FALLBACK_API_KEY=<fallback-provider-key>
# Chỉ cần khi provider = custom (API tương thích OpenAI):
# AI_TUTOR_BASE_URL=https://<host>/v1
# Khoá bổ sung cho ai_model_routes.key_ref (tuỳ chọn):
# AI_TUTOR_KEY_3=
# AI_TUTOR_KEY_4=
AI_TUTOR_MAX_RETRIES=1
AI_TUTOR_TIMEOUT=30000
# 1 = provider giả lập. KHÔNG bật ở production.
AI_TUTOR_MOCK=0
# Ghi hội thoại vào Supabase như Edge Function hiện tại (true/false).
AI_PERSIST_CONVERSATIONS=true

# --- Giới hạn & thời gian chờ --------------------------------------------
REQUEST_TIMEOUT_MS=45000
MAX_BODY_BYTES=262144
RATE_LIMIT_PER_MIN=240
AI_RATE_LIMIT_PER_MIN=30
# Chỉ bật khi chạy sau reverse proxy có kiểm soát (tin X-Forwarded-For).
TRUST_PROXY=false
